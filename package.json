{
  "name": "knowledge-base-index-search-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "dev": "\"$npm_execpath\" run build:ui && \"$npm_execpath\" --hot src/server/cli.ts",
    "build": "\"$npm_execpath\" run build:ui && \"$npm_execpath\" run typecheck",
    "build:ui": "vite build",
    "serve": "\"$npm_execpath\" run build:ui && \"$npm_execpath\" run src/server/cli.ts",
    "config": "\"$npm_execpath\" run scripts/operations.ts config",
    "doctor": "\"$npm_execpath\" run scripts/operations.ts doctor",
    "reconcile": "\"$npm_execpath\" run scripts/operations.ts reconcile",
    "reindex": "\"$npm_execpath\" run scripts/operations.ts reindex",
    "rebuild": "\"$npm_execpath\" run scripts/operations.ts rebuild",
    "reset": "\"$npm_execpath\" run scripts/operations.ts reset",
    "root": "\"$npm_execpath\" run scripts/operations.ts root",
    "version": "\"$npm_execpath\" run scripts/operations.ts version",
    "help": "\"$npm_execpath\" run scripts/operations.ts help",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "model:setup": "\"$npm_execpath\" run scripts/setup-model.ts",
    "format": "biome format --write .",
    "test": "\"$npm_execpath\" test",
    "test:ui": "\"$npm_execpath\" test src/ui",
    "test:e2e": "playwright test",
    "test:coverage": "\"$npm_execpath\" test --coverage --coverage-reporter=text",
    "smoke:operations": "\"$npm_execpath\" run scripts/operations-smoke.ts",
    "compat": "\"$npm_execpath\" run build:ui && \"$npm_execpath\" run scripts/compatibility-check.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@lancedb/lancedb": "0.37.1",
    "apache-arrow": "18.1.0",
    "highlight.js": "11.11.1",
    "mermaid": "11.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@happy-dom/global-registrator": "20.11.6",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "happy-dom": "20.11.6",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "trustedDependencies": [
    "onnxruntime-node"
  ]
}
